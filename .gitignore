# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

!Plugins/WwiseSoundEngine/ThirdParty/**/*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
# .vsconfig 记录 VS 所需组件，保留在仓库里供新成员自动安装

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Project UAT extension loaded by the editor's native packaging workflow.
!Build/Automation/
!Build/Automation/*.cs
!Build/Automation/*.csproj

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Wwise（每位成员本地集成，不进仓库）
Plugins/Wwise*/
Plugins/AkAudio/
Plugins/Audiokinetic*/

# Debug symbols
*.pdb

# Generated by the editor for HLSL tools
shadertoolsconfig.json

# IDE / local tooling
.idea/
*.code-workspace
.claude/worktrees/
.claude/settings.local.json
