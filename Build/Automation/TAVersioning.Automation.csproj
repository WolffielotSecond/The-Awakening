<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>../../Intermediate/Automation/TAVersioning/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(EngineDir)/Source/Programs/Shared/UnrealEngine.csproj.props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>TAVersioning.Automation</AssemblyName>
    <Configurations>Debug;Release;Development</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">Development</Configuration>
    <OutputPath>../../Intermediate/Automation/TAVersioning/bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Use installed engine binaries; do not rebuild or modify engine projects. -->
  <ItemGroup>
    <Reference Include="AutomationUtils.Automation">
      <HintPath>$(EngineDir)/Binaries/DotNET/AutomationTool/AutomationUtils/AutomationUtils.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(EngineDir)/Binaries/DotNET/AutomationTool/Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
